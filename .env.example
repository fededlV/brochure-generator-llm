# ==============================================================================
# AI Company Brochure Generator - Environment Configuration
# Copy this file to '.env' and fill in your confidential API keys:
#   cp .env.example .env
#
# SECURITY WARNING:
#   - Never commit your '.env' file to version control.
#   - Never bake secrets into Docker images or Dockerfiles.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Credentials (REQUIRED)
# Obtain your key at Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Backwards-compatible key alias
# GOOGLE_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. AI Model Selection
# Recommended lightweight & fast models:
#   - gemini-3.5-flash-lite (Default, rapid link filtering & synthesis)
#   - gemini-2.5-flash
# ------------------------------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 3. Docker Compose & NGINX Reverse Proxy Port Bindings (Host ports)
# ------------------------------------------------------------------------------
# Public HTTP port bound on host (NGINX reverse proxy)
HTTP_PORT=80

# Public HTTPS port bound on host (optional, when SSL certificates are configured)
HTTPS_PORT=443

# ------------------------------------------------------------------------------
# 4. Internal Backend Server (FastAPI)
# Note: In Docker Compose, these are internal container settings.
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000