# Version Control
.git/
.gitignore

# Environment & Secrets (NEVER bake secrets into images)
.env
*.env
*.env.local
*.env.*.local
*.pem
*.key
*.crt

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node / Frontend artifacts
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Documentation & Spec files (not needed in runtime images)
docs/
tasks/
CAPABILITY-MAP.md
SPEC.md
README.md

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Docker
docker-compose*.override.yml
